rules_version = '2';
// SYNTHESIS Firestore rules.
// The app stores one document per signed-in person at
// users/{uid}/app/progress (see firebase-sync.js). Each person may read and
// write only their own subtree; everything else is denied.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
